{
  "name": "claude-code-search-history",
  "version": "1.0.0",
  "description": "Search through Claude Code conversation history across all local projects",
  "main": "./out/main/index.js",
  "author": "Claude Code Search",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true && cp build/icon.icns node_modules/electron/dist/Electron.app/Contents/Resources/electron.icns 2>/dev/null || true",
    "package": "electron-vite build && electron-builder --mac --config",
    "package:win": "electron-vite build && electron-builder --win --config",
    "package:linux": "electron-vite build && electron-builder --linux --config",
    "build:web": "vite build --config vite.web.config.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "electron-vite build && npx playwright test",
    "test:e2e:headed": "electron-vite build && npx playwright test --headed",
    "test:e2e:ui": "electron-vite build && npx playwright test --ui",
    "test:e2e:debug": "electron-vite build && PWDEBUG=1 npx playwright test --headed"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@threadbase/core": "github:RonenMars/threadbase-core",
    "@threadbase/ui": "github:RonenMars/threadbase-ui",
    "@tanstack/react-virtual": "^3.14.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "flexsearch": "^0.8.212",
    "node-pty": "^1.1.0",
    "one-more-highlight": "^1.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
